# --- Sanity (public, used by the read-only client) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=2f8mtiiu
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# --- Lead capture (REQUIRED for /api/contact and /api/subscribe) ---
# A Sanity token with write access. Without it the forms return a 503 and tell the
# visitor to email directly, rather than pretending the submission succeeded.
SANITY_WRITE_TOKEN=

# --- Booking link (optional) ---
# A Cal.com / Calendly URL. When empty, the "Book a call" buttons are not rendered.
NEXT_PUBLIC_BOOKING_URL=

# --- Email notification on a new lead (optional) ---
# Leads are always stored in Sanity. These only add an email ping on top.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=leads@iamtayyab.com

# --- Analytics ---
GOOGLE_ANALYTICS_ID=GOOGLE_ANALYTICS_ID
